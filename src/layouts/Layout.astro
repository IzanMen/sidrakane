---
import Header from '../components/Header';
import '@fontsource-variable/dm-sans';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
interface Props { title?:string; description?:string; lang?:string; alternate?:string; image?:string; }
const {title='Sidra Kane · Menorca, a otro ritmo',description='Descubre Sidra Kane en Sa Marjal Vella: visita al caserío, historia y cata con producto menorquín. 90 minutos, 30 € por persona. Reserva tu experiencia en Menorca.',lang='es',alternate='/en/',image='/og.png'}=Astro.props;
const en=lang==='en';
const root=en?'/en/':'/';
const canonical=new URL(Astro.url.pathname,Astro.site);
const imageUrl=new URL(image,Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#f6f3e9"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={canonical}/>
  <link rel="alternate" hreflang={en?'en':'es'} href={canonical}/><link rel="alternate" hreflang={en?'es':'en'} href={new URL(alternate,Astro.site)}/>
  <meta property="og:type" content="website"/><meta property="og:locale" content={en?'en_GB':'es_ES'}/><meta property="og:site_name" content="Sidra Kane"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageUrl}/><meta property="og:image:alt" content="Sidra Kane · Menorca"/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageUrl}/>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Sidra Kane',url:Astro.site?.href,telephone:'+34722258029',image:new URL('/images/estate.webp',Astro.site).href,location:{'@type':'Place',name:'Sa Marjal Vella',address:{'@type':'PostalAddress',addressLocality:'Menorca',addressRegion:'Illes Balears',addressCountry:'ES'},geo:{'@type':'GeoCoordinates',latitude:39.9406401,longitude:3.9010656}}})}/>
</head>
<body>
  <a class="skip-link" href="#main">{en?'Skip to content':'Saltar al contenido'}</a>
  <Header lang={lang} alternate={alternate} client:load/>
  <main id="main"><slot/></main>
  <footer class="site-footer"><div class="footer-top"><a class="wordmark" href={root}><span>KANE<span class="logo-star" aria-hidden="true">✳</span></span><small>SIDRA · MENORCA</small></a><p>{en?'British heritage.':'Herencia británica.'}<br/><em>{en?'Mediterranean soul.':'Alma mediterránea.'}</em></p><a href={root+'visita/'} class="footer-link">{en?'Come and discover us':'Ven a conocernos'} <span aria-hidden="true">↗</span></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Sidra Kane</span><nav aria-label={en?'Footer navigation':'Navegación del pie'}><a href={root+'patrimonio/'}>{en?'Heritage':'Patrimonio'}</a><a href={root+'colaboraciones/'}>{en?'Collaborations':'Colaboraciones'}</a><a href={root+'contacto/'}>{en?'Contact':'Contacto'}</a><a href={root+'privacidad/'}>{en?'Privacy':'Privacidad'}</a></nav><span>Sa Marjal Vella · Menorca</span></div></footer>
  <a class="mobile-booking" href={root+'visita/'}><span>{en?'Visit & tasting':'Visita y cata'} <b>30 €</b></span><strong>{en?'Book your visit':'Reserva tu visita'} <span aria-hidden="true">↗</span></strong></a>
</body>
</html>
