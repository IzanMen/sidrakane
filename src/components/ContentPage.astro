---
import {ArrowUpRight,Clock,MapPin,Phone,Sun,Users,Leaf,Check} from 'lucide-react';
import {products,txt,mapsUrl,bookingUrl} from '../data/content';
import BookingPlanner from './BookingPlanner';
import Faq from './Faq';
import VisitCta from './VisitCta.astro';
const {lang='es',page='visita'}=Astro.props;
const en=lang==='en';const root=en?'/en/':'/';
const t=(es:string,english:string)=>en?english:es;
const journey=[
 ['El caserío','The estate','Recorremos Sa Marjal Vella, una finca del siglo XVIII en el corazón rural de Menorca. Aquí es donde elaboramos nuestra sidra.','We explore Sa Marjal Vella, an 18th-century estate in the heart of rural Menorca. This is where we craft our cider.'],
 ['La historia','The story','Seguimos las raíces británicas de la sidra en Menorca y descubrimos la poma d’en Kane, la manzana que inspiró nuestro proyecto.','We follow the British roots of cider in Menorca and discover the Poma d’en Kane, the apple that inspired our project.'],
 ['La cata','The tasting','Probamos Sidra Kane en una cata comentada para entender su elaboración, sus aromas y el carácter de cada cosecha.','We taste Sidra Kane in a guided session to understand how it is made, its aromas and the character of each harvest.'],
 ['El maridaje','The pairings','Acompañamos la sidra con producto menorquín seleccionado según la temporada. Sabores que también cuentan la isla.','We pair the cider with Menorcan produce selected for the season. Flavours that tell the island’s story, too.'],
 ['El paisaje','The landscape','Nos dejamos envolver por la calma y la naturaleza del entorno mediterráneo. Porque parte de la experiencia es simplemente estar aquí.','We take in the calm and nature of the Mediterranean surroundings. Part of the experience is simply being here.']
];
---
{page==='visita'&&<>
<section class="page-hero visit-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('La experiencia','The experience')}</a><p class="eyebrow">SA MARJAL VELLA · MENORCA</p><h1>{t('Un paseo.','A walk.')}<br/>{t('Una historia.','A story.')}<br/><em>{t('Una buena copa.','A good glass.')}</em></h1><p>{t('Ven a descubrir el lugar donde nace Sidra Kane. Una experiencia para conocer, probar y disfrutar la Menorca más rural.','Come and discover where Sidra Kane begins. An experience to explore, taste and enjoy rural Menorca.')}</p><div class="page-facts"><span><Clock size={17}/>90 {t('minutos','minutes')}</span><span><Users size={17}/>{t('Niños hasta 12, gratis','Children up to 12 free')}</span><span><Check size={17}/>{t('Reserva previa','Advance booking')}</span></div><a class="text-link" href="#reserva">{t('Organiza tu visita','Plan your visit')}<ArrowUpRight size={18}/></a></div><div class="page-hero-image"><img src="/images/estate.webp" alt={t('Fachada del caserío Sa Marjal Vella','The façade of Sa Marjal Vella')} width="788" height="514" fetchpriority="high"/><span class="image-caption">SA MARJAL VELLA · SIGLO XVIII</span></div></section>
<section class="section visit-content"><div class="visit-details"><p class="eyebrow">{t('ESTO ES LO QUE TE ESPERA','HERE’S WHAT TO EXPECT')}</p><h2>{t('Cinco formas de','Five ways to')}<br/><em>{t('conectar con la isla.','connect with the island.')}</em></h2><div class="journey-list">{journey.map((item,i)=><div class="journey-item"><span class="journey-number">0{i+1}</span><div><h3>{item[en?1:0]}</h3><p>{item[en?3:2]}</p></div></div>)}</div><figure class="inline-photo"><img src="/images/tasting.webp" alt={t('Sidra Kane, manzanas y piezas de la marca en una mesa mediterránea','Kane cider, apples and branded objects on a Mediterranean table')} width="788" height="499" loading="lazy"/><figcaption>{t('El sabor de Menorca, sin prisa.','The taste of Menorca, without the rush.')}</figcaption></figure><div class="season-note"><Sun size={23}/><div><h3>{t('El verano, a su ritmo.','Summer, at its own pace.')}</h3><p>{t('Horario de verano publicado: viernes a domingo, de 11:00 a 12:30 y de 18:30 a 20:00. Para tu fecha, consulta los horarios disponibles en el calendario.','Published summer schedule: Friday to Sunday, 11:00–12:30 and 18:30–20:00. Check the calendar for the times available on your date.')}</p></div></div><div class="group-note"><h3>{t('¿Un plan en grupo?','Planning a group visit?')}</h3><p>{t('Para grupos, eventos o actividades especiales, cuéntanos tu idea. El equipo te ayudará a organizar la experiencia y te confirmará el precio.','For groups, events or special activities, tell us your idea. The team will help arrange the experience and confirm the price.')}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{t('Hablemos por WhatsApp','Let’s talk on WhatsApp')}<ArrowUpRight size={18}/></a></div></div><aside id="reserva" class="booking-aside" aria-label={t('Planificar la visita','Plan your visit')}><BookingPlanner lang={lang} client:load/><div class="aside-location"><MapPin size={19}/><div><strong>Sa Marjal Vella, Menorca</strong><a href={root+'contacto/'}>{t('Ver cómo llegar','Find your way here')} <span aria-hidden="true">↗</span></a></div></div></aside></section>
<section class="section faq-section"><div><p class="eyebrow">{t('ANTES DE VENIR','BEFORE YOU COME')}</p><h2>{t('Nos gusta ponerlo','We like to keep it')}<br/><em>{t('fácil.','simple.')}</em></h2><p>{t('La información que necesitas para disfrutar de tu visita.','Everything you need to enjoy your visit.')}</p></div><Faq lang={lang} client:visible/></section>
</>}
{page==='historia'&&<>
<section class="page-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Nuestra historia','Our story')}</a><p class="eyebrow">{t('HERENCIA BRITÁNICA. ALMA MEDITERRÁNEA.','BRITISH HERITAGE. MEDITERRANEAN SOUL.')}</p><h1>{t('Una manzana.','One apple.')}<br/>{t('Una isla.','One island.')}<br/><em>{t('Otra historia.','Another story.')}</em></h1><p>{t('En una isla de vino nació una sidra. Y detrás de ella, el deseo de recuperar una pequeña parte de la historia de Menorca.','On an island of wine, a cider was born. Behind it, a wish to recover a small piece of Menorca’s history.')}</p><a class="text-link" href={root+'visita/'}>{t('Ven a conocerla','Come and discover it')}<ArrowUpRight size={18}/></a></div><div class="page-hero-image"><img src="/images/origin.webp" alt={t('La imagen del origen de Kane, con manzanas y una puerta abierta al campo','Kane’s origin imagery, with apples and a doorway onto the countryside')} width="956" height="1024" fetchpriority="high"/><span class="image-caption">MENORCA · DESDE 2021</span></div></section>
<section class="section story-editorial"><div><p class="eyebrow">{t('EL ORIGEN','THE BEGINNING')}</p><h2>{t('Todo empezó','It all began')}<br/><em>{t('con una conversación.','with a conversation.')}</em></h2></div><div><p>{t('En 2021, una charla sobre el legado británico del siglo XVIII en Menorca nos llevó hasta una variedad de manzana singular: la poma d’en Kane. Esa historia nos animó a crear algo diferente con esta fruta.','In 2021, a conversation about Menorca’s 18th-century British legacy led us to a distinctive apple: the Poma d’en Kane. Its story inspired us to create something different from this fruit.')}</p><p>{t('Nuestra primera bodega fue una antigua cochera de Ciutadella. Allí empezó la aventura de Sidra Kane: un proyecto artesanal con los pies en la isla y la mirada en su memoria.','Our first cider cellar was a former garage in Ciutadella. That was the start of Sidra Kane: an artisan project rooted in the island and its memory.')}</p><p>{t('Hoy te invitamos a descubrirlo en Sa Marjal Vella, un caserío histórico del siglo XVIII en la Menorca rural. El lugar donde elaboramos nuestra sidra y compartimos su historia.','Today, we invite you to discover it at Sa Marjal Vella, a historic 18th-century estate in rural Menorca, where we make our cider and share its story.')}</p></div></section>
<section class="story-section story-light"><div class="story-image"><img src="/images/apple.webp" alt="Poma d’en Kane" width="826" height="566" loading="lazy"/></div><div class="story-copy"><p class="eyebrow">POMA D’EN KANE</p><h2>{t('Casi olvidada.','Almost forgotten.')}<br/><em>{t('Hoy, recuperada.','Now, rediscovered.')}</em></h2><p>{t('Esta variedad llegó a Menorca con la influencia británica del siglo XVIII. Su equilibrio entre dulzor, acidez y aroma la hace especial. Recuperarla nos permite conservar ese legado y darle una nueva vida en nuestra sidra.','This variety arrived in Menorca with 18th-century British influence. Its balance of sweetness, acidity and aroma makes it distinctive. Recovering it lets us preserve that legacy and give it new life in our cider.')}</p><a class="text-link" href={root+'patrimonio/'}>{t('El patrimonio que cuidamos','The heritage we care for')}<ArrowUpRight size={18}/></a></div></section>
<section class="section harvest-section"><div><p class="eyebrow">{t('NOTAS DE LA COSECHA PUBLICADA','NOTES FROM THE PUBLISHED HARVEST')}</p><h2>{t('Cada año,','Every year,')}<br/><em>{t('su propio carácter.','its own character.')}</em></h2><p>{t('Un invierno húmedo, una primavera suave y una floración tardía dieron una sidra más seca, con acidez marcada y elegante. El campo marca el ritmo.','A wet winter, a mild spring and late blossom produced a drier cider with a pronounced, elegant acidity. The countryside sets the pace.')}</p></div><dl class="tasting-notes"><div><dt>{t('Acidez','Acidity')}</dt><dd>6,2 g/l <small>{t('ácido málico','malic acid')}</small></dd></div><div><dt>{t('Aromas','Aromas')}</dt><dd>{t('Cítricos y herbáceos','Citrus & herbal')}</dd></div><div><dt>{t('Final','Finish')}</dt><dd>{t('Largo, fresco y mineral','Long, fresh & mineral')}</dd></div><div><dt>{t('Cada cosecha','Each harvest')}</dt><dd>{t('Es irrepetible','Is unique')}</dd></div></dl></section>
<VisitCta lang={lang}/>
</>}
{page==='patrimonio'&&<>
<section class="page-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Patrimonio','Heritage')}</a><p class="eyebrow">{t('CUIDAR LO QUE NOS HACE ÚNICOS','CARING FOR WHAT MAKES US UNIQUE')}</p><h1>{t('No solo hacemos','We make more')}<br/>{t('sidra. Cuidamos','than cider. We care')}<br/><em>{t('una memoria.','for a legacy.')}</em></h1><p>{t('Recuperar la poma d’en Kane nos llevó a descubrir otras variedades históricas que sobrevivían en silencio. Hoy también trabajamos para que su historia continúe.','Recovering the Poma d’en Kane led us to other historic varieties quietly surviving on the island. Today, we work to keep their stories alive, too.')}</p></div><div class="page-hero-image"><img src="/images/heritage.webp" alt={t('Imagen del proyecto de recuperación de la Manzana de San Felipe','Imagery of the San Felipe apple recovery project')} width="953" height="1024" fetchpriority="high"/><span class="image-caption">{t('MANZANA DE SAN FELIPE','SAN FELIPE APPLE')}</span></div></section>
<section class="section story-editorial"><div><p class="eyebrow">{t('EL PROYECTO DE RECUPERACIÓN','THE RECOVERY PROJECT')}</p><h2>{t('Del rescate de una manzana','From rescuing an apple')}<br/><em>{t('a conservar un patrimonio.','to preserving a heritage.')}</em></h2></div><div><p>{t('La Manzana de San Felipe fue introducida por los ingleses y plantada en el recinto del Castillo de San Felipe. Hoy quedan pocos ejemplares. Su valor histórico y su fragilidad nos impulsaron a iniciar un proyecto para localizarla, estudiarla y protegerla.','The San Felipe apple was introduced by the British and planted within San Felipe Castle. Few specimens remain today. Its historical importance and vulnerability inspired a project to locate, study and protect it.')}</p><p>{t('Cada botella de Sidra Kane ayuda a financiar su conservación. Es una manera de cuidar los antiguos cultivos, los conocimientos agrícolas y el paisaje que forma parte de la identidad de Menorca.','Every bottle of Sidra Kane helps fund its conservation, supporting the old crops, agricultural knowledge and landscape that form part of Menorca’s identity.')}</p><div class="editorial-callout"><Leaf size={22}/><strong>{t('La Manzana de San Felipe se conserva; no se utiliza para elaborar Sidra Kane.','The San Felipe apple is protected; it is not used to make Sidra Kane.')}</strong></div></div></section>
<section class="section conservation-section"><p class="eyebrow">{t('CÓMO LO HACEMOS','HOW WE DO IT')}</p><h2>{t('Seis pasos para','Six steps to')}<br/><em>{t('que siga existiendo.','keep it growing.')}</em></h2><div class="conservation-grid">{(en?['Locate surviving trees','Map their distribution','Analyse their genetics','Create a graft bank','Record oral history','Fund conservation through cider']:['Localizar los árboles supervivientes','Cartografiar su distribución','Analizar su genética','Crear un banco de injertos','Registrar la historia oral','Financiar su conservación con la sidra']).map((item,i)=><div><span>0{i+1}</span><h3>{item}</h3></div>)}</div></section>
<VisitCta lang={lang}/>
</>}
{page==='coleccion'&&<>
<section class="collection-hero section"><p class="eyebrow">{t('COLECCIÓN KANE','THE KANE COLLECTION')}</p><h1>{t('El carácter de una isla.','An island’s character.')}<br/><em>{t('Más allá de una copa.','Beyond a glass.')}</em></h1><p>{t('Junto a artesanos y productores locales, exploramos otras formas de compartir los sabores, aromas y recuerdos de Menorca.','With local artisans and producers, we explore other ways to share Menorca’s flavours, aromas and memories.')}</p><span class="collection-notice">{t('Una colección en camino · Próximamente','A collection in the making · Coming soon')}</span></section>
<section class="section collection-full"><div class="product-grid">{products.map(product=><article class="product-card"><div class="product-image"><img src={'/images/'+product.image+'.webp'} alt={txt(product.title,en)} width="1400" height="1120" loading="lazy"/><span class="soon-tag">{t('PRÓXIMAMENTE','COMING SOON')}</span></div><div class="product-caption"><h2>{txt(product.title,en)}</h2></div><p class="product-subtitle">{txt(product.subtitle,en)}</p><p class="product-description">{txt(product.text,en)}</p></article>)}</div><div class="collection-contact"><h3>{t('¿Quieres saber más?','Want to know more?')}</h3><p>{t('Consulta con el equipo las novedades de la colección.','Ask the team about news from the collection.')}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{t('Habla con Kane','Talk to Kane')}<ArrowUpRight size={18}/></a></div></section>
<VisitCta lang={lang}/>
</>}
{page==='colaboraciones'&&<>
<section class="collection-hero section"><p class="eyebrow">{t('COLABORACIONES','COLLABORATIONS')}</p><h1>{t('La isla se disfruta','The island is better')}<br/><em>{t('en buena compañía.','in good company.')}</em></h1><p>{t('Encuentros con personas y proyectos que comparten nuestra forma de mirar Menorca. Otras maneras de descubrir el universo Kane.','Encounters with people and projects that share our way of seeing Menorca. Other ways to discover the world of Kane.')}</p></section>
<section class="collaboration-story"><div class="collaboration-photo"><img src="/images/night.webp" alt={t('Imagen de Noches de Estrellas en el caserío Kane','Kane’s Starlit Evenings estate imagery')} width="1088" height="540" loading="lazy"/></div><div class="collaboration-copy"><p class="eyebrow">{t('UNA EXPERIENCIA BAJO EL CIELO','AN EXPERIENCE UNDER THE SKY')}</p><h2>{t('Noches','Starlit')}<br/><em>{t('de Estrellas.','evenings.')}</em></h2><p>{t('Observación astronómica con una guía acreditada Starlight, interpretación del cielo nocturno y degustación de productos locales. Una invitación a mirar hacia arriba y disfrutar de la naturaleza.','Astronomical observation with a Starlight-accredited guide, interpretation of the night sky and local produce tasting. An invitation to look up and enjoy nature.')}</p><p class="collaboration-note">{t('Consulta fechas, disponibilidad y precio de esta actividad especial con el equipo.','Ask the team for dates, availability and pricing for this special activity.')}</p><a class="text-link" href={'https://wa.me/34722258029?text='+encodeURIComponent(t('¡Hola! Me gustaría recibir información sobre Noches de Estrellas: fechas y precio.','Hello! I would like information about Starlit Evenings: dates and price.'))} target="_blank" rel="noopener noreferrer">{t('Quiero saber más','Tell me more')}<ArrowUpRight size={18}/></a></div></section>
<section class="collaboration-story collaboration-reverse"><div class="collaboration-photo bottle-collaboration"><img src="/images/collaboration.webp" alt={t('Botella de la colaboración limitada Kane y Grahame Pearce','Bottle from the limited Kane and Grahame Pearce collaboration')} width="488" height="1165" loading="lazy"/></div><div class="collaboration-copy"><p class="eyebrow">{t('UNA COLABORACIÓN LIMITADA','A LIMITED COLLABORATION')}</p><h2>Grahame Pearce<br/><em>× Kane.</em></h2><p>{t('Algunas cosechas abren caminos nuevos. Esta colaboración se elabora con mosto de poma d’en Kane prensado en nuestro obrador, uniendo la selección de manzanas de Menorca y el trabajo de artesanos locales.','Some harvests open new paths. This collaboration uses Poma d’en Kane juice pressed in our workshop, bringing together selected Menorcan apples and the work of local artisans.')}</p><p class="collaboration-note">{t('Edición limitada. Consulta su disponibilidad con Kane.','Limited edition. Ask Kane about availability.')}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{t('Descubre la colaboración','Discover the collaboration')}<ArrowUpRight size={18}/></a></div></section>
<VisitCta lang={lang}/>
</>}
{page==='contacto'&&<>
<section class="page-hero contact-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Cómo llegar','Find us')}</a><p class="eyebrow">{t('EL CAMINO HASTA KANE','YOUR WAY TO KANE')}</p><h1>{t('Nos vemos','See you')}<br/><em>{t('en el campo.','in the countryside.')}</em></h1><p>{t('Te esperamos en Sa Marjal Vella, un caserío del siglo XVIII rodeado de la calma de la Menorca rural. Guarda la ubicación y reserva antes de venir.','We’ll see you at Sa Marjal Vella, an 18th-century estate surrounded by the calm of rural Menorca. Save the location and book before you come.')}</p><a class="button" href={mapsUrl} target="_blank" rel="noopener noreferrer">{t('Abrir ubicación en Google Maps','Open location in Google Maps')}<ArrowUpRight size={20}/></a></div><div class="page-hero-image"><img src="/images/estate.webp" alt="Sa Marjal Vella, Menorca" width="788" height="514" fetchpriority="high"/><span class="image-caption">SA MARJAL VELLA · 39.94064, 3.90107</span></div></section>
<section class="section contact-grid"><div><MapPin size={25}/><p class="eyebrow">{t('DÓNDE ESTAMOS','WHERE WE ARE')}</p><h2>Sa Marjal Vella.</h2><p>Menorca, Illes Balears</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">{t('Ver ubicación exacta','See exact location')}<ArrowUpRight size={18}/></a></div><div><Phone size={25}/><p class="eyebrow">{t('HABLEMOS','LET’S TALK')}</p><h2>+34 722 258 029</h2><p>{t('Para dudas, grupos y actividades especiales.','For questions, groups and special activities.')}</p><div class="contact-links"><a class="text-link" href="tel:+34722258029">{t('Llamar','Call')}<ArrowUpRight size={17}/></a><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">WhatsApp<ArrowUpRight size={17}/></a></div></div><div><Clock size={25}/><p class="eyebrow">{t('HORARIO DE VERANO PUBLICADO','PUBLISHED SUMMER TIMES')}</p><h2>{t('Viernes a domingo.','Friday to Sunday.')}</h2><p>11:00 — 12:30<br/>18:30 — 20:00</p><a class="text-link" href={bookingUrl} target="_blank" rel="noopener noreferrer">{t('Consultar horarios para mi fecha','Check times for my date')}<ArrowUpRight size={17}/></a></div></section>
<section class="section arrival-section"><div><p class="eyebrow">{t('PARA DISFRUTAR DESDE EL PRINCIPIO','ENJOY IT FROM THE START')}</p><h2>{t('Un poco de previsión.','A little planning.')}<br/><em>{t('Y todo el tiempo para disfrutar.','Plenty of time to enjoy.')}</em></h2></div><ol><li><span>01</span><div><h3>{t('Reserva tu visita','Book your visit')}</h3><p>{t('La experiencia requiere reserva previa. Elige fecha y hora en el calendario de Kane.','Advance booking is required. Choose your date and time in Kane’s calendar.')}</p></div></li><li><span>02</span><div><h3>{t('Guarda la ubicación','Save the location')}</h3><p>{t('Usa el enlace de Google Maps para encontrar la finca.','Use the Google Maps link to find the estate.')}</p></div></li><li><span>03</span><div><h3>{t('Cuéntanos lo que necesitas','Tell us what you need')}</h3><p>{t('Si tienes dudas sobre el acceso, necesidades de movilidad o el maridaje, contacta con el equipo antes de venir.','If you have questions about access, mobility needs or food pairings, contact the team before coming.')}</p></div></li></ol></section>
<VisitCta lang={lang}/>
</>}
{page==='privacidad'&&<section class="section privacy-content"><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Privacidad','Privacy')}</a><p class="eyebrow">{t('NAVEGACIÓN Y SERVICIOS EXTERNOS','BROWSING & EXTERNAL SERVICES')}</p><h1>{t('Tu visita a esta web.','Your visit to this website.')}</h1><h2>{t('Una navegación sencilla','Simple browsing')}</h2><p>{t('Esta web no incorpora publicidad, analítica de terceros ni formularios que guarden tus datos. El cálculo orientativo de la visita se realiza en tu navegador y no se envía a Kane.','This website includes no advertising, third-party analytics or forms that store your information. The estimated visit cost is calculated in your browser and is not sent to Kane.')}</p><h2>{t('Reservas y consultas','Bookings & enquiries')}</h2><p>{t('Para reservar, te dirigimos al calendario de la web de Sidra Kane. Para consultar por WhatsApp, se abre un mensaje preparado que tú decides enviar. Los datos que facilites en estos servicios se gestionan en sus propias plataformas.','Bookings open the calendar on Sidra Kane’s website. WhatsApp enquiries open a prepared message that you choose to send. Information you provide in those services is handled on their respective platforms.')}</p><h2>Google Maps</h2><p>{t('El mapa se abre solo cuando pulsas el enlace a Google Maps. Esta web no carga un mapa integrado ni solicita tu ubicación.','The map opens only when you follow the Google Maps link. This website does not load an embedded map or request your location.')}</p><h2>{t('Contacto','Contact')}</h2><p>{t('Para dudas sobre la información que facilitas al reservar o contactar, puedes hablar con Sidra Kane en el +34 722 258 029.','For questions about information you provide when booking or contacting the team, reach Sidra Kane at +34 722 258 029.')}</p><a class="text-link" href="tel:+34722258029">{t('Contactar con Kane','Contact Kane')}<ArrowUpRight size={18}/></a></section>}
