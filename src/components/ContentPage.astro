---
import {ArrowUpRight,Clock,MapPin,Phone,Sun,Users,Leaf,Check} from 'lucide-react';
import {products,txt,mapsUrl,bookingUrl} from '../data/content';
import BookingPlanner from './BookingPlanner';
import Faq from './Faq';
import VisitCta from './VisitCta.astro';
const {lang='es',page='visita'}=Astro.props;
const en=lang==='en';const root=en?'/en/':'/';
const t=(es:string,english:string)=>en?english:es;
const journey=[
 ['El caserío','The estate','Recorremos Sa Marjal Vella, una finca del siglo XVIII en el entorno rural de Menorca. Aquí es donde elaboramos nuestra sidra.','We explore Sa Marjal Vella, an 18th-century estate in rural Menorca. This is where we craft our cider.'],
 ['La historia','The story','Seguimos las raíces británicas de la sidra en Menorca y descubrimos la poma d’en Kane, la manzana que inspiró nuestro proyecto.','We follow the British roots of cider in Menorca and discover the Poma d’en Kane, the apple that inspired our project.'],
 ['La cata','The tasting','Probamos Sidra Kane en una cata comentada para entender su elaboración, sus aromas y el carácter de cada cosecha.','We taste Sidra Kane in a guided session to understand how it is made, its aromas and the character of each harvest.'],
 ['El maridaje','The pairings','Acompañamos la sidra con producto menorquín seleccionado según la temporada. Los productos varían según la temporada.','We pair the cider with Menorcan produce selected for the season. Products vary with the season.'],
 ['El entorno de la finca','The estate’s surroundings','Durante el recorrido conocemos el entorno rural de Sa Marjal Vella.','The tour introduces you to Sa Marjal Vella’s rural surroundings.']
];
---
{page==='visita'&&<>
<section class="page-hero visit-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('La visita','The visit')}</a><p class="eyebrow">SA MARJAL VELLA · MENORCA</p><h1>{t('Visita a Sidra Kane','Visit Sidra Kane')}<br/><em>{t('con cata y maridaje.','with tasting & food pairings.')}</em></h1><p>{t('Recorre Sa Marjal Vella, conoce la historia de nuestra sidra y pruébala con producto menorquín de temporada. La visita dura 90 minutos y cuesta 30 € por persona.','Tour Sa Marjal Vella, learn about our cider and taste it with seasonal Menorcan food. The visit lasts 90 minutes and costs €30 per person.')}</p><div class="page-facts"><span><Clock size={17}/>90 {t('minutos','minutes')}</span><span><Users size={17}/>{t('Niños hasta 12, gratis','Children up to 12 free')}</span><span><Check size={17}/>{t('Reserva previa','Advance booking')}</span></div><a class="text-link" href="#reserva">{t('Reservar visita','Book a visit')}<ArrowUpRight size={18}/></a></div><div class="page-hero-image"><img src="/images/estate.webp" alt={t('Fachada del caserío Sa Marjal Vella','The façade of Sa Marjal Vella')} width="788" height="514" fetchpriority="high"/><span class="image-caption">SA MARJAL VELLA · SIGLO XVIII</span></div></section>
<section class="section visit-content"><div class="visit-details"><p class="eyebrow">{t('RECORRIDO Y CATA','TOUR & TASTING')}</p><h2>{t('Qué incluye','What’s included')}<br/><em>{t('la visita.','in your visit.')}</em></h2><div class="journey-list">{journey.map((item,i)=><div class="journey-item"><span class="journey-number">0{i+1}</span><div><h3>{item[en?1:0]}</h3><p>{item[en?3:2]}</p></div></div>)}</div><figure class="inline-photo"><img src="/images/tasting.webp" alt={t('Sidra Kane, manzanas y piezas de la marca en una mesa mediterránea','Kane cider, apples and branded objects on a Mediterranean table')} width="788" height="499" loading="lazy"/><figcaption>{t('Cata de Sidra Kane con producto local de temporada.','Sidra Kane tasting with seasonal local food.')}</figcaption></figure><div class="season-note"><Sun size={23}/><div><h3>{t('Horario de verano publicado','Published summer schedule')}</h3><p>{t('Horario de verano publicado: viernes a domingo, de 11:00 a 12:30 y de 18:30 a 20:00. Consulta el calendario para confirmar el horario de tu fecha.','Published summer schedule: Friday to Sunday, 11:00–12:30 and 18:30–20:00. Check the calendar for the times available on your date.')}</p></div></div><div class="group-note"><h3>{t('¿Un plan en grupo?','Planning a group visit?')}</h3><p>{t('Para grupos, eventos o actividades especiales, contacta con el equipo para consultar fechas, opciones y precio.','Contact the team for dates, options and prices for groups, events or special activities.')}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{t('Consultar por WhatsApp','Enquire on WhatsApp')}<ArrowUpRight size={18}/></a></div></div><aside id="reserva" class="booking-aside" aria-label={t('Planificar la visita','Plan your visit')}><BookingPlanner lang={lang} client:load/><div class="aside-location"><MapPin size={19}/><div><strong>Sa Marjal Vella, Menorca</strong><a href={root+'contacto/'}>{t('Ver cómo llegar','Get directions')} <span aria-hidden="true">↗</span></a></div></div></aside></section>
<section class="section faq-section"><div><p class="eyebrow">{t('ANTES DE VENIR','BEFORE YOU COME')}</p><h2>{t('Información','Information')}<br/><em>{t('para tu visita.','for your visit.')}</em></h2><p>{t('Precio, horarios, reserva y ubicación.','Price, times, booking and location.')}</p></div><Faq lang={lang} client:visible/></section>
</>}
{page==='historia'&&<>
<section class="page-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Nuestra historia','Our story')}</a><p class="eyebrow">{t('SIDRA ARTESANAL · DESDE 2021','CRAFT CIDER · SINCE 2021')}</p><h1>{t('Sidra artesanal','Craft cider')}<br/><em>{t('con manzanas de Menorca.','made with Menorcan apples.')}</em></h1><p>{t('Sidra Kane empezó en 2021 para recuperar la poma d’en Kane, una variedad de manzana ligada al pasado británico de Menorca, y elaborar sidra artesanal.','Sidra Kane began in 2021 to recover the Poma d’en Kane, an apple variety linked to Menorca’s British past, and make craft cider.')}</p><a class="text-link" href={root+'visita/'}>{t('Visita el caserío y prueba la sidra','Visit the estate and taste our cider')}<ArrowUpRight size={18}/></a></div><div class="page-hero-image"><img src="/images/origin.webp" alt={t('La imagen del origen de Kane, con manzanas y una puerta abierta al campo','Kane’s origin imagery, with apples and a doorway onto the countryside')} width="956" height="1024" fetchpriority="high"/><span class="image-caption">MENORCA · DESDE 2021</span></div></section>
<section class="section story-editorial"><div><p class="eyebrow">{t('EL ORIGEN','THE BEGINNING')}</p><h2>{t('Cómo empezó','How Sidra Kane')}<br/><em>{t('Sidra Kane.','began.')}</em></h2></div><div><p>{t('En 2021, una charla sobre el legado británico del siglo XVIII en Menorca nos llevó hasta una variedad de manzana singular: la poma d’en Kane. Decidimos recuperarla para elaborar sidra.','In 2021, a conversation about Menorca’s 18th-century British legacy led us to a distinctive apple: the Poma d’en Kane. We decided to recover it to make cider.')}</p><p>{t('Nuestra primera bodega fue una antigua cochera de Ciutadella. Allí empezamos a elaborar Sidra Kane de forma artesanal.','Our first cider cellar was a former garage in Ciutadella. That is where we started making Sidra Kane by hand.')}</p><p>{t('Hoy elaboramos la sidra en Sa Marjal Vella, un caserío del siglo XVIII en la Menorca rural. Allí recibimos las visitas y realizamos las catas.','Today, we make cider at Sa Marjal Vella, an 18th-century estate in rural Menorca. We welcome visitors and hold our tastings there.')}</p></div></section>
<section class="story-section story-light"><div class="story-image"><img src="/images/apple.webp" alt="Poma d’en Kane" width="826" height="566" loading="lazy"/></div><div class="story-copy"><p class="eyebrow">POMA D’EN KANE</p><h2>{t('La variedad','The apple variety')}<br/><em>{t('que recuperamos.','we recovered.')}</em></h2><p>{t('Esta variedad llegó a Menorca con la influencia británica del siglo XVIII. Combina dulzor, acidez y aroma. Recuperamos esta variedad para conservarla y utilizarla en nuestra sidra.','This variety arrived in Menorca with 18th-century British influence. It combines sweetness, acidity and aroma. We recovered the variety to preserve it and use it in our cider.')}</p><a class="text-link" href={root+'patrimonio/'}>{t('Nuestro proyecto de conservación','Our conservation project')}<ArrowUpRight size={18}/></a></div></section>
<section class="section harvest-section"><div><p class="eyebrow">{t('NOTAS DE LA COSECHA PUBLICADA','NOTES FROM THE PUBLISHED HARVEST')}</p><h2>{t('Notas de','Notes from')}<br/><em>{t('la cosecha publicada.','the published harvest.')}</em></h2><p>{t('Un invierno húmedo, una primavera suave y una floración tardía dieron una sidra más seca, con acidez marcada y elegante. Las características de la sidra varían con cada cosecha.','A wet winter, a mild spring and late blossom produced a drier cider with a pronounced, elegant acidity. The cider’s characteristics vary with each harvest.')}</p></div><dl class="tasting-notes"><div><dt>{t('Acidez','Acidity')}</dt><dd>6,2 g/l <small>{t('ácido málico','malic acid')}</small></dd></div><div><dt>{t('Aromas','Aromas')}</dt><dd>{t('Cítricos y herbáceos','Citrus & herbal')}</dd></div><div><dt>{t('Final','Finish')}</dt><dd>{t('Largo, fresco y mineral','Long, fresh & mineral')}</dd></div><div><dt>{t('Cada cosecha','Each harvest')}</dt><dd>{t('Tiene características distintas','Has different characteristics')}</dd></div></dl></section>
<VisitCta lang={lang}/>
</>}
{page==='patrimonio'&&<>
<section class="page-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Patrimonio','Heritage')}</a><p class="eyebrow">{t('PATRIMONIO AGRÍCOLA','AGRICULTURAL HERITAGE')}</p><h1>{t('Recuperación de la','Conservation of the')}<br/><em>{t('Manzana de San Felipe.','San Felipe apple.')}</em></h1><p>{t('Trabajamos para localizar, estudiar y conservar la Manzana de San Felipe, una variedad histórica de Menorca de la que quedan pocos ejemplares.','We work to locate, study and conserve the San Felipe apple, a historic Menorcan variety with few surviving trees.')}</p></div><div class="page-hero-image"><img src="/images/heritage.webp" alt={t('Imagen del proyecto de recuperación de la Manzana de San Felipe','Imagery of the San Felipe apple recovery project')} width="953" height="1024" fetchpriority="high"/><span class="image-caption">{t('MANZANA DE SAN FELIPE','SAN FELIPE APPLE')}</span></div></section>
<section class="section story-editorial"><div><p class="eyebrow">{t('EL PROYECTO DE RECUPERACIÓN','THE RECOVERY PROJECT')}</p><h2>{t('Por qué conservamos','Why we conserve')}<br/><em>{t('esta variedad.','this variety.')}</em></h2></div><div><p>{t('La Manzana de San Felipe fue introducida por los ingleses y plantada en el recinto del Castillo de San Felipe. Hoy quedan pocos ejemplares. Su valor histórico y su fragilidad nos impulsaron a iniciar un proyecto para localizarla, estudiarla y protegerla.','The San Felipe apple was introduced by the British and planted within San Felipe Castle. Few specimens remain today. Its historical importance and vulnerability inspired a project to locate, study and protect it.')}</p><p>{t('Cada botella de Sidra Kane ayuda a financiar su conservación. Es una manera de cuidar los antiguos cultivos, los conocimientos agrícolas y el paisaje que forma parte de la identidad de Menorca.','Every bottle of Sidra Kane helps fund its conservation, supporting the old crops, agricultural knowledge and landscape that form part of Menorca’s identity.')}</p><div class="editorial-callout"><Leaf size={22}/><strong>{t('La Manzana de San Felipe se conserva; no se utiliza para elaborar Sidra Kane.','The San Felipe apple is protected; it is not used to make Sidra Kane.')}</strong></div></div></section>
<section class="section conservation-section"><p class="eyebrow">{t('CÓMO LO HACEMOS','HOW WE DO IT')}</p><h2>{t('Medidas de','Conservation')}<br/><em>{t('conservación.','measures.')}</em></h2><div class="conservation-grid">{(en?['Locate surviving trees','Map their distribution','Analyse their genetics','Create a graft bank','Record oral history','Fund conservation through cider']:['Localizar los árboles supervivientes','Cartografiar su distribución','Analizar su genética','Crear un banco de injertos','Registrar la historia oral','Financiar su conservación con la sidra']).map((item,i)=><div><span>0{i+1}</span><h3>{item}</h3></div>)}</div></section>
<VisitCta lang={lang}/>
</>}
{page==='coleccion'&&<>
<section class="collection-hero section"><p class="eyebrow">{t('COLECCIÓN KANE','THE KANE COLLECTION')}</p><h1>{t('Productos de la','Products from the')}<br/><em>{t('Colección Kane.','Kane collection.')}</em></h1><p>{t('Una colección con artesanos y productores locales: aperitivo, miel, vinagre de sidra, packs, jabones, velas y cosméticos.','A collection created with local artisans and producers: aperitif, honey, cider vinegar, sets, soaps, candles and cosmetics.')}</p><span class="collection-notice">{t('Próximamente · Estos productos aún no están a la venta','Coming soon · These products are not on sale yet')}</span></section>
<section class="section collection-full"><div class="product-grid">{products.map(product=><article class="product-card"><div class="product-image"><img src={'/images/'+product.image+'.webp'} alt={txt(product.title,en)} width="1400" height="1120" loading="lazy"/><span class="soon-tag">{t('PRÓXIMAMENTE','COMING SOON')}</span></div><div class="product-caption"><h2>{txt(product.title,en)}</h2></div><p class="product-subtitle">{txt(product.subtitle,en)}</p><p class="product-description">{txt(product.text,en)}</p></article>)}</div><div class="collection-contact"><h3>{t('Información de la colección','Collection information')}</h3><p>{t('Consulta con el equipo las novedades de la colección.','Ask the team about news from the collection.')}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{t('Consultar novedades por WhatsApp','Enquire about updates on WhatsApp')}<ArrowUpRight size={18}/></a></div></section>
<VisitCta lang={lang}/>
</>}
{page==='colaboraciones'&&<>
<section class="collection-hero section"><p class="eyebrow">{t('COLABORACIONES','COLLABORATIONS')}</p><h1>{t('Actividades y','Activities &')}<br/><em>{t('colaboraciones.','collaborations.')}</em></h1><p>{t('Organizamos observación astronómica con degustación y colaboramos con Grahame Pearce en una edición limitada con mosto de manzana.','We organise astronomical observation with local food tasting and collaborate with Grahame Pearce on a limited edition made with apple juice.')}</p></section>
<section class="collaboration-story"><div class="collaboration-photo"><img src="/images/night.webp" alt={t('Imagen de Noches de Estrellas en el caserío Kane','Kane’s Starlit Evenings estate imagery')} width="1088" height="540" loading="lazy"/></div><div class="collaboration-copy"><p class="eyebrow">{t('OBSERVACIÓN ASTRONÓMICA Y DEGUSTACIÓN','ASTRONOMICAL OBSERVATION & FOOD TASTING')}</p><h2>{t('Noches','Starlit')}<br/><em>{t('de Estrellas.','evenings.')}</em></h2><p>{t('Observación astronómica con una guía acreditada Starlight, interpretación del cielo nocturno y degustación de productos locales.','Astronomical observation with a Starlight-accredited guide, interpretation of the night sky and local produce tasting.')}</p><p class="collaboration-note">{t('Consulta fechas, disponibilidad y precio de esta actividad especial con el equipo.','Ask the team for dates, availability and pricing for this special activity.')}</p><a class="text-link" href={'https://wa.me/34722258029?text='+encodeURIComponent(t('¡Hola! Me gustaría recibir información sobre Noches de Estrellas: fechas y precio.','Hello! I would like information about Starlit Evenings: dates and price.'))} target="_blank" rel="noopener noreferrer">{t('Consultar fechas y precio','Enquire about dates and price')}<ArrowUpRight size={18}/></a></div></section>
<section class="collaboration-story collaboration-reverse"><div class="collaboration-photo bottle-collaboration"><img src="/images/collaboration.webp" alt={t('Botella de la colaboración limitada Kane y Grahame Pearce','Bottle from the limited Kane and Grahame Pearce collaboration')} width="488" height="1165" loading="lazy"/></div><div class="collaboration-copy"><p class="eyebrow">{t('UNA COLABORACIÓN LIMITADA','A LIMITED COLLABORATION')}</p><h2>Grahame Pearce<br/><em>× Kane.</em></h2><p>{t('Edición limitada con Grahame Pearce, elaborada con mosto de poma d’en Kane prensado en nuestro obrador y manzanas seleccionadas de Menorca.','A limited edition with Grahame Pearce, made with Poma d’en Kane juice pressed in our workshop from selected Menorcan apples.')}</p><p class="collaboration-note">{t('Edición limitada. Consulta su disponibilidad con Kane.','Limited edition. Ask Kane about availability.')}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{t('Consultar disponibilidad','Enquire about availability')}<ArrowUpRight size={18}/></a></div></section>
<VisitCta lang={lang}/>
</>}
{page==='contacto'&&<>
<section class="page-hero contact-hero"><div><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Cómo llegar','Find us')}</a><p class="eyebrow">{t('UBICACIÓN Y CONTACTO','LOCATION & CONTACT')}</p><h1>{t('Cómo llegar','How to get')}<br/><em>{t('a Sidra Kane.','to Sidra Kane.')}</em></h1><p>{t('Estamos en Sa Marjal Vella, un caserío del siglo XVIII en la Menorca rural. Abre la ubicación exacta en Google Maps y reserva antes de venir.','We are at Sa Marjal Vella, an 18th-century estate in rural Menorca. Open the exact location in Google Maps and book before visiting.')}</p><a class="button" href={mapsUrl} target="_blank" rel="noopener noreferrer">{t('Abrir ubicación en Google Maps','Open location in Google Maps')}<ArrowUpRight size={20}/></a></div><div class="page-hero-image"><img src="/images/estate.webp" alt="Sa Marjal Vella, Menorca" width="788" height="514" fetchpriority="high"/><span class="image-caption">SA MARJAL VELLA · 39.94064, 3.90107</span></div></section>
<section class="section contact-grid"><div><MapPin size={25}/><p class="eyebrow">{t('DÓNDE ESTAMOS','WHERE WE ARE')}</p><h2>Sa Marjal Vella.</h2><p>Menorca, Illes Balears</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">{t('Ver ubicación exacta','See exact location')}<ArrowUpRight size={18}/></a></div><div><Phone size={25}/><p class="eyebrow">{t('TELÉFONO Y WHATSAPP','PHONE & WHATSAPP')}</p><h2>+34 722 258 029</h2><p>{t('Para dudas, grupos y actividades especiales.','For questions, groups and special activities.')}</p><div class="contact-links"><a class="text-link" href="tel:+34722258029">{t('Llamar','Call')}<ArrowUpRight size={17}/></a><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">WhatsApp<ArrowUpRight size={17}/></a></div></div><div><Clock size={25}/><p class="eyebrow">{t('HORARIO DE VERANO PUBLICADO','PUBLISHED SUMMER TIMES')}</p><h2>{t('Viernes a domingo.','Friday to Sunday.')}</h2><p>11:00 — 12:30<br/>18:30 — 20:00</p><a class="text-link" href={bookingUrl} target="_blank" rel="noopener noreferrer">{t('Consultar horarios para mi fecha','Check times for my date')}<ArrowUpRight size={17}/></a></div></section>
<section class="section arrival-section"><div><p class="eyebrow">{t('PREPARA TU VISITA','PLAN YOUR VISIT')}</p><h2>{t('Antes de','Before')}<br/><em>{t('venir.','visiting.')}</em></h2></div><ol><li><span>01</span><div><h3>{t('Reserva tu visita','Book your visit')}</h3><p>{t('La experiencia requiere reserva previa. Elige fecha y hora en el calendario de Kane.','Advance booking is required. Choose your date and time in Kane’s calendar.')}</p></div></li><li><span>02</span><div><h3>{t('Guarda la ubicación','Save the location')}</h3><p>{t('Usa el enlace de Google Maps para encontrar la finca.','Use the Google Maps link to find the estate.')}</p></div></li><li><span>03</span><div><h3>{t('Cuéntanos lo que necesitas','Tell us what you need')}</h3><p>{t('Si tienes dudas sobre el acceso, necesidades de movilidad o el maridaje, contacta con el equipo antes de venir.','If you have questions about access, mobility needs or food pairings, contact the team before coming.')}</p></div></li></ol></section>
<VisitCta lang={lang}/>
</>}
{page==='privacidad'&&<section class="section privacy-content"><a class="breadcrumb" href={root}>{t('Inicio','Home')} <span>/</span> {t('Privacidad','Privacy')}</a><p class="eyebrow">{t('NAVEGACIÓN Y SERVICIOS EXTERNOS','BROWSING & EXTERNAL SERVICES')}</p><h1>{t('Privacidad y servicios externos.','Privacy & external services.')}</h1><h2>{t('Datos en esta web','Data on this website')}</h2><p>{t('Esta web no incorpora publicidad, analítica de terceros ni formularios que guarden tus datos. El cálculo orientativo de la visita se realiza en tu navegador y no se envía a Kane.','This website includes no advertising, third-party analytics or forms that store your information. The estimated visit cost is calculated in your browser and is not sent to Kane.')}</p><h2>{t('Reservas y consultas','Bookings & enquiries')}</h2><p>{t('Para reservar, te dirigimos al calendario de la web de Sidra Kane. Para consultar por WhatsApp, se abre un mensaje preparado que tú decides enviar. Los datos que facilites en estos servicios se gestionan en sus propias plataformas.','Bookings open the calendar on Sidra Kane’s website. WhatsApp enquiries open a prepared message that you choose to send. Information you provide in those services is handled on their respective platforms.')}</p><h2>Google Maps</h2><p>{t('El mapa se abre solo cuando pulsas el enlace a Google Maps. Esta web no carga un mapa integrado ni solicita tu ubicación.','The map opens only when you follow the Google Maps link. This website does not load an embedded map or request your location.')}</p><h2>{t('Contacto','Contact')}</h2><p>{t('Para dudas sobre la información que facilitas al reservar o contactar, puedes hablar con Sidra Kane en el +34 722 258 029.','For questions about information you provide when booking or contacting the team, reach Sidra Kane at +34 722 258 029.')}</p><a class="text-link" href="tel:+34722258029">{t('Contactar con Kane','Contact Kane')}<ArrowUpRight size={18}/></a></section>}
