---
import {ArrowUpRight,ArrowDown,MapPin,Clock,Ticket} from 'lucide-react';
import {experienceSteps,products,txt} from '../data/content';
import Faq from './Faq';
import VisitCta from './VisitCta.astro';
const {lang='es',base}=Astro.props;
const en=lang==='en';const root=base || (en?'/en/':'/');
---
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{en?'CRAFT CIDER · MENORCA':'SIDRA ARTESANAL · MENORCA'}</p>
    <h1>{en?'Visit Sidra Kane.':'Visita Sidra Kane.'}<br/><em>{en?'Taste our cider.':'Prueba nuestra sidra.'}</em></h1>
    <p class="hero-description">{en?'We make cider at Sa Marjal Vella, an 18th-century estate in Menorca. Visit the estate and enjoy a guided tasting with seasonal local food.':'Elaboramos sidra en Sa Marjal Vella, un caserío del siglo XVIII en Menorca. Visita la finca y disfruta de una cata comentada con producto local de temporada.'}</p>
    <div class="hero-links">
      <a class="button" href={root+'visita/#reserva'}>{en?'Book a visit':'Reservar visita'}<ArrowUpRight size={20}/></a>
      <a class="text-link" href="#experiencia">{en?'What’s included':'Qué incluye la visita'}<ArrowDown size={18}/></a>
    </div>
    <div class="hero-facts">
      <span><Ticket size={18}/><span><b>30 €</b> {en?'per person':'por persona'}</span></span>
      <span><Clock size={18}/><span><b>90</b> {en?'minutes':'minutos'}</span></span>
      <span class="hero-kids">{en?'Children up to 12: free':'Niños hasta 12 años: gratis'}</span>
    </div>
  </div>
  <figure class="hero-visual">
    <div class="hero-photo-frame"><img class="hero-photo" src="/images/estate.webp" alt={en?'Sa Marjal Vella, the estate where we make Sidra Kane and welcome visitors':'Sa Marjal Vella, la finca donde elaboramos Sidra Kane y recibimos las visitas'} width="788" height="514" fetchpriority="high"/></div>
    <figcaption><MapPin size={16}/><span>Sa Marjal Vella · Menorca</span><span class="hero-photo-detail">{en?'18th-century estate':'Caserío del siglo XVIII'}</span></figcaption>
  </figure>
</section>
<section id="experiencia" class="section experience-section">
  <p class="eyebrow">{en?'THE VISIT':'LA VISITA'}</p>
  <h2>{en?'Estate tour, history':'Recorrido por el caserío, historia'}<br/><em>{en?'and cider tasting.':'y cata de sidra.'}</em></h2>
  <p class="section-intro">{en?'During the 90-minute visit, we show you where we make our cider, explain its connection to Menorca and guide you through a tasting with local food.':'Durante los 90 minutos de visita, te enseñamos dónde elaboramos nuestra sidra, explicamos su relación con Menorca y guiamos una cata con producto local.'}</p>
  <div class="experience-grid">
    {experienceSteps.map((step,i)=><a class="experience-card" href={root+'visita/'}>
      <div class="card-image"><img src={'/images/'+step.image+'.webp'} alt={txt(step.title,en)} width="788" height="514" loading="lazy"/><span class="card-number">0{i+1}</span><span class="card-arrow"><ArrowUpRight size={20}/></span></div>
      <div class="card-copy"><p class="eyebrow">{txt(step.tag,en)}</p><h3>{txt(step.title,en)}</h3><p>{txt(step.text,en)}</p></div>
    </a>)}
  </div>
  <a class="text-link" href={root+'visita/'}>{en?'View the full visit and booking options':'Ver la visita completa y cómo reservar'}<ArrowUpRight size={19}/></a>
</section>
<section class="story-section">
  <div class="story-image"><img src="/images/orchard.webp" alt={en?'Poma d’en Kane apples':'Manzanas de la variedad poma d’en Kane'} width="715" height="1024" loading="lazy"/><span class="story-image-label">POMA D’EN KANE<small>{en?'APPLE VARIETY · MENORCA':'VARIEDAD DE MANZANA · MENORCA'}</small></span></div>
  <div class="story-copy">
    <p class="eyebrow">{en?'OUR CIDER':'NUESTRA SIDRA'}</p>
    <h2>{en?'Made with':'Elaborada con'}<br/><em>poma d’en Kane.</em></h2>
    <p>{en?'The Poma d’en Kane is an apple variety introduced to Menorca during the British period in the 18th century. It combines sweetness, acidity and aroma. We recovered it to make our craft cider.':'La poma d’en Kane es una variedad de manzana introducida en Menorca durante la época británica, en el siglo XVIII. Combina dulzor, acidez y aroma. La recuperamos para elaborar nuestra sidra artesanal.'}</p>
    <p>{en?'Sidra Kane began in 2021. Our first cider cellar was a former garage in Ciutadella. Today, we make our cider and welcome visitors at Sa Marjal Vella.':'Sidra Kane empezó en 2021. Nuestra primera bodega fue una antigua cochera de Ciutadella. Hoy elaboramos la sidra y recibimos las visitas en Sa Marjal Vella.'}</p>
    <a class="text-link" href={root+'historia/'}>{en?'How Sidra Kane began':'Cómo empezó Sidra Kane'}<ArrowUpRight size={20}/></a>
  </div>
</section>
<section class="section collection-preview">
  <div class="section-heading">
    <div><p class="eyebrow">{en?'THE KANE COLLECTION':'COLECCIÓN KANE'}</p><h2>{en?'New products':'Nuevos productos'}<br/><em>{en?'with local makers.':'con productores locales.'}</em></h2></div>
    <div><p>{en?'We are preparing a collection with local artisans and producers: an aperitif, honey, cider vinegar, soaps and more. These products are coming soon.':'Preparamos una colección con artesanos y productores locales: un aperitivo, miel, vinagre de sidra, jabones y otros productos. Estarán disponibles próximamente.'}</p><a class="text-link" href={root+'coleccion/'}>{en?'See the upcoming collection':'Ver los próximos productos'}<ArrowUpRight size={19}/></a></div>
  </div>
  <div class="product-grid home-products">{[products[0],products[1],products[4]].map(product=><a class="product-card" href={root+'coleccion/'}><div class="product-image"><img src={'/images/'+product.image+'.webp'} alt={txt(product.title,en)} width="1400" height="1120" loading="lazy"/><span class="soon-tag">{en?'COMING SOON':'PRÓXIMAMENTE'}</span></div><div class="product-caption"><h3>{txt(product.title,en)}</h3><ArrowUpRight size={20}/></div><p>{txt(product.subtitle,en)}</p></a>)}</div>
</section>
<section class="heritage-strip">
  <span aria-hidden="true">✳</span>
  <p>{en?'Each bottle helps fund conservation':'Cada botella ayuda a financiar la conservación'}<br/><em>{en?'of the San Felipe apple.':'de la Manzana de San Felipe.'}</em></p>
  <a class="text-link" href={root+'patrimonio/'}>{en?'Read about the conservation project':'Conoce el proyecto de conservación'}<ArrowUpRight size={18}/></a>
</section>
<VisitCta lang={lang} base={root}/>
<section class="section faq-section">
  <div><p class="eyebrow">{en?'PRACTICAL INFORMATION':'INFORMACIÓN PRÁCTICA'}</p><h2>{en?'Before':'Antes de'}<br/><em>{en?'your visit.':'tu visita.'}</em></h2><p>{en?'Price, duration, booking and location. If you need more information, contact us on WhatsApp.':'Precio, duración, reserva y ubicación. Si necesitas más información, escríbenos por WhatsApp.'}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{en?'Contact us on WhatsApp':'Contactar por WhatsApp'}<ArrowUpRight size={18}/></a></div>
  <Faq lang={lang} client:visible/>
</section>
