---
import {ArrowUpRight,ArrowDown,MapPin,Clock,Ticket} from 'lucide-react';
import {experienceSteps,products,txt} from '../data/content';
import Faq from './Faq';
import VisitCta from './VisitCta.astro';
const {lang='es'}=Astro.props;
const en=lang==='en';const root=en?'/en/':'/';
---
<section class="hero">
  <div class="hero-copy"><p class="eyebrow"><span aria-hidden="true">✳</span> {en?'CRAFT CIDER. ISLAND SOUL.':'SIDRA ARTESANAL. ALMA DE ISLA.'}</p>
    <h1>{en?'Menorca,':'Menorca,'}<br/>{en?'at a':'a otro'}<br/><em>{en?'slower pace.':'ritmo.'}</em></h1>
    <p class="hero-description">{en?'A historic estate. A cider with a story. Come and taste a different side of Menorca.':'Un caserío con historia. Una sidra con raíces. Ven a saborear la Menorca que se vive sin prisa.'}</p>
    <div class="hero-links"><a class="button" href={root+'visita/'}>{en?'Come and discover Kane':'Ven a descubrir Kane'}<ArrowUpRight size={20}/></a><a class="text-link" href="#experiencia">{en?'The experience':'Así es la experiencia'}<ArrowDown size={17}/></a></div>
    <div class="hero-facts"><span><Ticket size={16}/><b>30 €</b> {en?'per person':'por persona'}</span><span><Clock size={16}/><b>90</b> {en?'minutes':'minutos'}</span><span>{en?'Children up to 12 free':'Niños hasta 12 años, gratis'}</span></div>
  </div>
  <div class="hero-visual"><picture><source media="(max-width: 600px)" srcset="/images/hero-mobile.webp"/><img class="hero-photo" src="/images/hero.webp" alt={en?'Kane cider bottles overlooking the Mediterranean at sunset':'Botellas de Sidra Kane frente al Mediterráneo al atardecer'} width="857" height="1024" fetchpriority="high"/></picture><div class="hero-location"><MapPin size={16}/><span>SA MARJAL VELLA, MENORCA</span></div><div class="hero-photo-caption"><span>{en?'British heritage.':'Herencia británica.'}</span><em>{en?'Mediterranean soul.':'Alma mediterránea.'}</em></div><span class="image-index">01 — KANE</span></div>
</section>
<div class="brand-ribbon" aria-hidden="true"><span>MENORCA EN CADA SORBO</span><i>✳</i><span>POMA D’EN KANE</span><i>✳</i><span>HECHA CON HISTORIA</span><i>✳</i><span>ALMA MEDITERRÁNEA</span><i>✳</i></div>
<section id="experiencia" class="section experience-section"><p class="eyebrow">{en?'THE KANE EXPERIENCE':'LA EXPERIENCIA KANE'}</p><h2>{en?'Some places are better':'Hay lugares que se entienden'}<br/><em>{en?'experienced.':'con una copa en la mano.'}</em></h2><p class="section-intro">{en?'Walk through Sa Marjal Vella, discover the story behind our apples and enjoy a guided tasting with seasonal local produce.':'Recorre Sa Marjal Vella, descubre la historia de nuestras manzanas y disfruta de una cata comentada con producto local de temporada.'}</p>
<div class="experience-grid">{experienceSteps.map((step,i)=><a class="experience-card" href={root+'visita/'}><div class="card-image"><img src={'/images/'+step.image+'.webp'} alt={txt(step.title,en)} width="788" height="514" loading="lazy"/><span class="card-number">0{i+1}</span><span class="card-arrow"><ArrowUpRight size={20}/></span></div><div class="card-copy"><p class="eyebrow">{txt(step.tag,en)}</p><h3>{txt(step.title,en)}</h3><p>{txt(step.text,en)}</p></div></a>)}</div><a class="text-link" href={root+'visita/'}>{en?'Everything about your visit':'Todo lo que incluye tu visita'}<ArrowUpRight size={19}/></a></section>
<section class="story-section"><div class="story-image"><img src="/images/orchard.webp" alt={en?'Poma d’en Kane apples from the island':'Manzanas de la variedad poma d’en Kane'} width="715" height="1024" loading="lazy"/><span class="story-image-label">POMA D’EN KANE<br/><small>MENORCA · SIGLO XVIII</small></span></div><div class="story-copy"><p class="eyebrow">{en?'A STORY WORTH SAVOURING':'UNA HISTORIA QUE SE SABOREA'}</p><h2>{en?'British roots.':'Raíces británicas.'}<br/><em>{en?'Island soul.':'Alma de isla.'}</em></h2><p>{en?'It all began with an almost-forgotten apple. The Poma d’en Kane connects us to Menorca’s British past, and recovering it gave our cider its reason to be.':'Todo empezó con una manzana casi olvidada. La poma d’en Kane nos conecta con el pasado británico de Menorca, y recuperarla dio sentido a nuestra sidra.'}</p><p>{en?'Today, each bottle tells the story of a landscape, a harvest and the people who care for them. Come and discover it where it happens.':'Hoy, cada botella cuenta la historia de un paisaje, de una cosecha y de quienes los cuidan. Ven a descubrirla en el lugar donde sucede.'}</p><a class="text-link" href={root+'historia/'}>{en?'Meet our story':'Conoce nuestra historia'}<ArrowUpRight size={20}/></a><div class="story-note"><span aria-hidden="true">✳</span><span>{en?'Recovering an apple.':'Recuperar una manzana.'}<br/>{en?'Preserving a piece of Menorca.':'Conservar un pedacito de Menorca.'}</span></div></div></section>
<section class="slow-banner"><img src="/images/estate.webp" alt={en?'Sa Marjal Vella, home to Sidra Kane':'Sa Marjal Vella, el caserío de Sidra Kane'} width="788" height="514" loading="lazy"/><div><p class="eyebrow">SA MARJAL VELLA · MENORCA</p><h2>{en?'Less rush.':'Menos prisa.'}<br/><em>{en?'More island.':'Más isla.'}</em></h2><p>{en?'A different plan, in the heart of rural Menorca.':'Un plan diferente, en el corazón de la Menorca rural.'}</p><a class="button button-light" href={root+'visita/'}>{en?'I want to visit':'Quiero vivirlo'}<ArrowUpRight size={20}/></a></div></section>
<section class="section collection-preview"><div class="section-heading"><div><p class="eyebrow">{en?'THE KANE COLLECTION':'COLECCIÓN KANE'}</p><h2>{en?'A little more':'Un poquito más'}<br/><em>{en?'of Menorca.':'de Menorca.'}</em></h2></div><div><p>{en?'Flavours, aromas and objects created with local artisans. The island’s character, beyond cider.':'Sabores, aromas y objetos creados junto a artesanos locales. El carácter de la isla, más allá de la sidra.'}</p><a class="text-link" href={root+'coleccion/'}>{en?'Explore the collection':'Explora la colección'}<ArrowUpRight size={19}/></a></div></div><div class="product-grid home-products">{[products[0],products[1],products[4]].map(product=><a class="product-card" href={root+'coleccion/'}><div class="product-image"><img src={'/images/'+product.image+'.webp'} alt={txt(product.title,en)} width="1400" height="1120" loading="lazy"/><span class="soon-tag">{en?'COMING SOON':'PRÓXIMAMENTE'}</span></div><div class="product-caption"><h3>{txt(product.title,en)}</h3><ArrowUpRight size={20}/></div><p>{txt(product.subtitle,en)}</p></a>)}</div></section>
<section class="heritage-strip"><span aria-hidden="true">✳</span><p>{en?'Every bottle helps protect':'Cada botella ayuda a proteger'}<br/><em>{en?'a living heritage of Menorca.':'un patrimonio vivo de Menorca.'}</em></p><a class="text-link" href={root+'patrimonio/'}>{en?'Discover the project':'Descubre el proyecto'}<ArrowUpRight size={18}/></a></section>
<VisitCta lang={lang}/>
<section class="section faq-section"><div><p class="eyebrow">{en?'BEFORE YOU COME':'ANTES DE VENIR'}</p><h2>{en?'A few questions.':'Unas pocas dudas.'}<br/><em>{en?'Everything clear.':'Todo claro.'}</em></h2><p>{en?'And if you have another question, we’re just a message away.':'Y si te queda alguna pregunta, estamos a un mensaje de distancia.'}</p><a class="text-link" href="https://wa.me/34722258029" target="_blank" rel="noopener noreferrer">{en?'Talk to Kane':'Habla con Kane'}<ArrowUpRight size={18}/></a></div><Faq lang={lang} client:visible/></section>
